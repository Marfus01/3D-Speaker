{
    "fbank_dim": 80,
    "embedding_size": 192,
    "feature_extractor": {
        "obj": "speakerlab.process.processor.FBank",
        "args": {
            "n_mels": 80,
            "sample_rate": 16000,
            "mean_nor": true
        }
    },
    "embedding_model": {
        "obj": "speakerlab.models.campplus.DTDNN.CAMPPlus",
        "args": {
            "feat_dim": 80,
            "embedding_size": 512
        }
    },
    "min_box_size": 30,
    "min_box_prob": 0.8,
    "min_track": 10,
    "num_failed_det": 10,
    "crop_scale": 0.4,
    "min_face_size": 30,
    "face_det_stride": 5,
    "shot_stride": 50,
    "audio_cluster": {
        "obj": "speakerlab.process.cluster.CommonClustering",
        "args": {
            "cluster_type": "spectral",
            "min_num_spks": 13,
            "max_num_spks": 52,
            "min_cluster_size": 1,
            "minor_cluster_cos_thr": 0.8,
            "oracle_num": null,
            "pval": 0.032,
            "mer_cos": 0.8
        }
    },
    "vision_cluster": {
        "obj": "speakerlab.process.cluster.CommonClustering",
        "args": {
            "cluster_type": "AHC",
            "cluster_line": 2,
            "min_cluster_size": 1,
            "minor_cluster_cos_thr": 0.8,
            "fix_cos_thr": 0.25
        }
    },
    "cluster": {
        "obj": "speakerlab.process.cluster.JointClustering",
        "args": {
            "audio_cluster": "<audio_cluster>",
            "vision_cluster": "<vision_cluster>"
        }
    },
    "fix_cos_thr_mf": 0.15,
    "main_actors_num": 5,
    "selective_change": true,
    "pretrained_model": "runs/the big bang theory/exp_video_contrastive/contrastive_learning/contrastive_models/model_epoch_0200.pth"
}